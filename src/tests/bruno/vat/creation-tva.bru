meta {
  name: vat - création
  type: http
  seq: 10
}

post {
  url: http://localhost:3001/v1/interact/vat
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:json {
  {
    "type": "Z",
    "rate": 15
  }
}

assert {
  res.status: eq 201
}

tests {
  pm.test("La création de TVA retourne un body vide", () => {
    pm.expect(pm.response.text()).to.be.empty;
  });
}
