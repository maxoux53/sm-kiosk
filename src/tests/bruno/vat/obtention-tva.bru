meta {
  name: vat - obtention
  type: http
  seq: 11
}

get {
  url: http://localhost:3001/v1/interact/vat/Z
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

tests {
  pm.test("La réponse contient les champs de la TVA", () => {
    const json = pm.response.json();
    pm.expect(json).to.have.property("type");
    pm.expect(json).to.have.property("rate");
  });

  pm.test("Le type et le taux correspondent", () => {
    const json = pm.response.json();
    pm.expect(json.type).to.equal("Z");
    pm.expect(json.rate).to.equal(15);
  });
}
