meta {
  name: user - obtention
  type: http
  seq: 28
}

get {
  url: http://localhost:3001/v1/interact/user/{{userId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

tests {
  pm.test("La réponse contient les champs de l'utilisateur", () => {
    const json = pm.response.json();
    pm.expect(json).to.have.property("id");
    pm.expect(json).to.have.property("first_name");
    pm.expect(json).to.have.property("last_name");
    pm.expect(json).to.have.property("email");
  });

  pm.test("L'utilisateur correspond à celui connecté", () => {
    const json = pm.response.json();
    pm.expect(json.id).to.equal(pm.variables.get("userId"));
  });
}
