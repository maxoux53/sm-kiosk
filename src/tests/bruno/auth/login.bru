meta {
  name: login
  type: http
  seq: 1
}

post {
  url: http://localhost:3001/v1/login
  body: json
  auth: none
}

body:json {
  {
    "email": "jean.dupont@example.com",
    "password": "jeandupont123"
  }
}

tests {
  test("le code de réponse est 200", function() {
    expect(res.status).to.equal(200);
  });

  test("la réponse contient un token JWT", function() {
    expect(res.body).to.have.property("token");
    expect(res.body.token).to.be.a("string").and.not.empty;
  });

  test("la réponse contient un objet user avec id et is_admin", function() {
    expect(res.body).to.have.property("user");
    expect(res.body.user).to.have.property("id");
    expect(res.body.user).to.have.property("is_admin");
  });

  test("l'utilisateur connecté est admin", function() {
    expect(res.body.user.is_admin).to.be.true;
  });

  bru.setVar("jwt", res.body.token);
}
