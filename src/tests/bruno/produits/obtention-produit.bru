meta {
  name: obtention produit
  type: http
  seq: 8
}

get {
  url: http://localhost:3001/v1/interact/product/{{prod_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

tests {
  test("le code de réponse est 200", function() {
    expect(res.status).to.equal(200);
  });

  test("la réponse contient les propriétés id, label, is_available et excl_vat_price", function() {
    expect(res.body).to.have.property("id");
    expect(res.body).to.have.property("label");
    expect(res.body).to.have.property("is_available");
    expect(res.body).to.have.property("excl_vat_price");
  });

  test("le produit contient un objet category avec id, label et vat", function() {
    expect(res.body).to.have.property("category");
    expect(res.body.category).to.have.property("id");
    expect(res.body.category).to.have.property("label");
    expect(res.body.category).to.have.property("vat");
    expect(res.body.category.vat).to.have.property("rate");
  });

  test("l'id du produit correspond à celui demandé", function() {
    expect(res.body.id).to.equal(parseInt(bru.getVar("prod_id")));
  });
}
