meta {
  name: category - liste
  type: http
  seq: 16
}

get {
  url: http://localhost:3001/v1/interact/category
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

tests {
  pm.test("La réponse contient un tableau de catégories et une pagination", () => {
    const json = pm.response.json();
    pm.expect(json).to.have.property("data");
    pm.expect(json.data).to.be.an("array");
    pm.expect(json).to.have.property("pagination");
    pm.expect(json.pagination).to.have.property("total");
  });

  pm.test("La catégorie créée est présente dans la liste", () => {
    const json = pm.response.json();
    const found = json.data.some(c => c.id === pm.variables.get("categoryId"));
    pm.expect(found).to.be.true;
  });
}
