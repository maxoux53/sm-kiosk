meta {
  name: category - obtention
  type: http
  seq: 15
}

get {
  url: http://localhost:3001/v1/interact/category/{{categoryId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

tests {
  pm.test("La réponse contient les champs de la catégorie", () => {
    const json = pm.response.json();
    pm.expect(json).to.have.property("id");
    pm.expect(json).to.have.property("label");
    pm.expect(json).to.have.property("vat_type");
  });

  pm.test("La catégorie correspond à celle créée", () => {
    const json = pm.response.json();
    pm.expect(json.id).to.equal(pm.variables.get("categoryId"));
    pm.expect(json.label).to.equal("Catégorie de test");
  });
}
