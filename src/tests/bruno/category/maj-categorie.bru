meta {
  name: category - mise à jour
  type: http
  seq: 17
}

patch {
  url: http://localhost:3001/v1/interact/category/{{categoryId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:json {
  {
    "label": "Catégorie de test (maj)"
  }
}

assert {
  res.status: eq 204
}

tests {
  pm.test("La mise à jour de la catégorie retourne un body vide", () => {
    pm.expect(pm.response.text()).to.be.empty;
  });
}
