meta {
  name: obtention categories
  type: http
  seq: 2
}

get {
  url: http://localhost:3001/v1/interact/category?search=&offset=0&limit=20
  body: none
  auth: bearer
}

params:query {
  search: 
  offset: 0
  limit: 20
}

auth:bearer {
  token: {{jwt}}
}

tests {
  test("le code de réponse est 200", function() {
    expect(res.status).to.equal(200);
  });

  test("la réponse contient un tableau data et un objet pagination", function() {
    expect(res.body).to.have.property("data");
    expect(res.body.data).to.be.an("array");
    expect(res.body).to.have.property("pagination");
    expect(res.body.pagination).to.have.property("total");
    expect(res.body.pagination).to.have.property("offset");
    expect(res.body.pagination).to.have.property("limit");
  });

  test("chaque catégorie du tableau a les propriétés id, label, vat_type et picture", function() {
    res.body.data.forEach(function(category) {
      expect(category).to.have.property("id");
      expect(category).to.have.property("label");
      expect(category).to.have.property("vat_type");
      expect(category).to.have.property("picture");
    });
  });

  if (res.body.data.length > 0) {
    bru.setVar("cat_id", res.body.data[0].id);
  }
}
