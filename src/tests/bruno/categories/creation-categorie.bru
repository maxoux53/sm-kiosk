meta {
  name: creation categorie
  type: http
  seq: 4
}

post {
  url: http://localhost:3001/v1/interact/category
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:json {
  {
    "label": "Catégorie test Bruno",
    "vat_type": "A",
    "picture": "https://example.com/test-category.png"
  }
}

tests {
  test("le code de réponse est 201", function() {
    expect(res.status).to.equal(201);
  });

  test("la réponse contient un id (nombre entier)", function() {
    expect(res.body).to.have.property("id");
    expect(res.body.id).to.be.a("number");
    expect(res.body.id).to.be.above(0);
  });

  bru.setVar("new_cat_id", res.body.id);
}
