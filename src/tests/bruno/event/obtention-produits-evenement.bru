meta {
  name: produits de l'événement
  type: http
  seq: 22
}

get {
  url: http://localhost:3001/v1/interact/event/{{eventId}}/products
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

tests {
  pm.test("La réponse contient un tableau de produits", () => {
    const json = pm.response.json();
    pm.expect(json).to.be.an("array");
  });

  pm.test("Le produit créé est présent dans l'événement", () => {
    const json = pm.response.json();
    const found = json.some(p => p.id === pm.variables.get("productId"));
    pm.expect(found).to.be.true;
  });
}
