meta {
  name: event - obtention événement
  type: http
  seq: 7
}

get {
  url: http://localhost:3001/v1/interact/event/{{eventId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

tests {
  pm.test("La réponse contient les champs de l'événement", () => {
    const json = pm.response.json();
    pm.expect(json).to.have.property("id");
    pm.expect(json).to.have.property("name");
    pm.expect(json).to.have.property("location");
    pm.expect(json).to.have.property("iban");
    pm.expect(json).to.have.property("is_active");
  });

  pm.test("L'événement correspond à celui créé", () => {
    const json = pm.response.json();
    pm.expect(json.id).to.equal(pm.variables.get("eventId"));
    pm.expect(json.name).to.equal("Événement de test");
  });
}
