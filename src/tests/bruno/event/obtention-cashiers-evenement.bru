meta {
  name: event - cashiers de l'événement
  type: http
  seq: 31
}

get {
  url: http://localhost:3001/v1/interact/event/{{eventId}}/cashiers
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

tests {
  pm.test("La réponse est un tableau de cashiers", () => {
    const json = pm.response.json();
    pm.expect(json).to.be.an("array");
  });
}
