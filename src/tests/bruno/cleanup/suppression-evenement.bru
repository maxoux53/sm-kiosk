meta {
  name: nettoyage - suppression événement
  type: http
  seq: 39
}

delete {
  url: http://localhost:3001/v1/interact/event/{{eventId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 204
}

tests {
  pm.test("La suppression de l'événement retourne un body vide (204)", () => {
    pm.expect(pm.response.text()).to.be.empty;
  });
}
