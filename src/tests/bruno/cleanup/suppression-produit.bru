meta {
  name: nettoyage - suppression produit
  type: http
  seq: 35
}

delete {
  url: http://localhost:3001/v1/interact/product/{{productId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 204
}

tests {
  pm.test("La suppression retourne un body vide (204)", () => {
    pm.expect(pm.response.text()).to.be.empty;
  });
}
