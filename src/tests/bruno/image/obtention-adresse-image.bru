meta {
  name: image - upload URL
  type: http
  seq: 29
}

get {
  url: http://localhost:3001/v1/img-upload
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  pm.test("La réponse contient une URL d'upload", () => {
    const json = pm.response.json();
    pm.expect(json).to.have.property("uploadURL");
    pm.expect(json.uploadURL).to.be.a("string").and.not.empty;
  });
}
