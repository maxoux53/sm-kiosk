meta {
  name: me - mes achats
  type: http
  seq: 24
}

get {
  url: http://localhost:3001/v1/interact/me/purchases
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

tests {
  pm.test("La réponse est un tableau d'achats", () => {
    const json = pm.response.json();
    pm.expect(json).to.be.an("array");
  });

  pm.test("L'achat créé est présent", () => {
    const json = pm.response.json();
    const found = json.some(p => p.id === pm.variables.get("purchaseId"));
    pm.expect(found).to.be.true;
  });
}
