meta {
  name: obtention me
  type: http
  seq: 11
}

get {
  url: http://localhost:3001/v1/interact/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

tests {
  test("le code de réponse est 200", function() {
    expect(res.status).to.equal(200);
  });

  test("le profil contient id, first_name, last_name, email et is_admin", function() {
    expect(res.body).to.have.property("id");
    expect(res.body).to.have.property("first_name");
    expect(res.body).to.have.property("last_name");
    expect(res.body).to.have.property("email");
    expect(res.body).to.have.property("is_admin");
  });

  test("l'utilisateur du profil est admin", function() {
    expect(res.body.is_admin).to.be.true;
  });
}
