meta {
  name: me - obtention profil
  type: http
  seq: 3
}

get {
  url: http://localhost:3001/v1/interact/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

tests {
  pm.test("La réponse contient les champs du profil utilisateur", () => {
    const json = pm.response.json();
    pm.expect(json).to.have.property("id");
    pm.expect(json).to.have.property("first_name");
    pm.expect(json).to.have.property("last_name");
    pm.expect(json).to.have.property("email");
    pm.expect(json).to.have.property("is_admin");
  });

  pm.test("Le profil correspond à l'utilisateur connecté", () => {
    const json = pm.response.json();
    pm.expect(json.id).to.equal(pm.variables.get("userId"));
  });
}
