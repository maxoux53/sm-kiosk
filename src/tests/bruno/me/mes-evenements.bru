meta {
  name: me - mes événements
  type: http
  seq: 6
}

get {
  url: http://localhost:3001/v1/interact/me/events
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 200
}

tests {
  pm.test("La réponse est un tableau d'événements", () => {
    const json = pm.response.json();
    pm.expect(json).to.be.an("array");
  });

  pm.test("L'événement créé précédemment est présent", () => {
    const json = pm.response.json();
    const found = json.some(e => e.id === pm.variables.get("eventId"));
    pm.expect(found).to.be.true;
  });
}
