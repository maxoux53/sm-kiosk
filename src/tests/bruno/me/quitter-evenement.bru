meta {
  name: me - quitter événement
  type: http
  seq: 38
}

delete {
  url: http://localhost:3001/v1/interact/me/event/{{eventId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

assert {
  res.status: eq 204
}

tests {
  pm.test("Quitter l'événement retourne un body vide (204)", () => {
    pm.expect(pm.response.text()).to.be.empty;
  });
}
