meta {
  name: me - création achat
  type: http
  seq: 23
}

post {
  url: http://localhost:3001/v1/interact/me/purchase
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:json {
  {
    "order_lines": [
      {
        "product_id": {{productId}},
        "quantity": 2
      }
    ]
  }
}

assert {
  res.status: eq 201
}

tests {
  pm.test("La création d'achat retourne les données", () => {
    const json = pm.response.json();
    pm.expect(json).to.have.property("id");
    pm.expect(json).to.have.property("order_line");
    pm.expect(json.order_line).to.be.an("array");
    pm.expect(json.order_line).to.have.lengthOf(1);
  });

  bru.setVar("purchaseId", pm.response.json().id);
}
